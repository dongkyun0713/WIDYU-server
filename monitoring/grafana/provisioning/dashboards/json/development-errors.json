{
  "title": "WIDYU Development Errors",
  "uid": "widyu-development-errors",
  "timezone": "browser",
  "panels": [
    {
      "title": "API all logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{service=\"widyu-api-dev\", environment=\"dev\"}", "refId": "A" }
      ],
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "API ERROR logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{service=\"widyu-api-dev\", environment=\"dev\"} |~ \"ERROR|Exception\" |= \"$traceId\"", "refId": "A" }
      ],
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 18 }
    },
    {
      "title": "API 5xx responses (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"widyu-api\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx / sec",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "schemaVersion": 39,
  "version": 1
}
