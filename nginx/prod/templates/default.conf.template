server {
    listen 80;
    server_name ${PROD_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://${PROD_DOMAIN}$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${PROD_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${PROD_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PROD_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Resolve through Docker only when a request is proxied. This keeps nginx -t
    # usable for the first deployment before the API container exists.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $spring_backend widyu-api:8080;
    # Discard every client-supplied forwarding header, then establish this proxy
    # as the sole trusted forwarding boundary for Spring.
    proxy_set_header Host $server_name;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $server_name;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Forwarded-Ssl on;
    location /api/ { proxy_pass http://$spring_backend; }
    location /ws/ {
        proxy_pass http://$spring_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-Ssl on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
    location = /actuator/health { proxy_pass http://$spring_backend; }
    location /actuator/ { return 404; }
    location = /admin { return 301 /admin/; }
    location /admin/ {
        alias /usr/share/nginx/admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }
    location /.well-known/ { root /usr/share/nginx/admin; }
    location / { return 302 https://play.google.com/store/apps; }
}
